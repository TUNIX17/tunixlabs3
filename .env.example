# TunixLabs Environment Variables
# Copia este archivo a .env.local y completa los valores.

# Base de datos (Postgres; en Railway la entrega el servicio de Postgres)
DATABASE_URL=postgresql://user:password@host:port/database

# Correo (Resend): avisos internos de leads y formulario de contacto
RESEND_API_KEY=re_your_api_key_here
NOTIFICATION_EMAIL=contacto@tunixlabs.com

# Calendly: clave de firma del webhook (Calendly developer settings)
CALENDLY_WEBHOOK_SECRET=

# Panel admin (/admin)
ADMIN_PASSWORD=your_secure_password_here
# Genera con: openssl rand -base64 32
AUTH_SECRET=your_auth_secret_here

# Mantención: el sitio responde 503 salvo que MANTENCION=0.
# En local déjala en 0; en producción no la definas hasta publicar.
MANTENCION=0

# Plausible (analítica sin cookies). El script solo se inyecta si está definida;
# déjala sin definir en local.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=tunixlabs.com
